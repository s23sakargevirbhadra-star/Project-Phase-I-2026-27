MONGO_URI=mongodb://localhost:27017

# Flask uses SECRET_KEY to sign the session cookie.
# Change this to any long random string before going live.
SECRET_KEY=change-this-to-a-long-random-string

# Gmail address used to send OTP emails.
# Leave empty to use TEST MODE (OTP is printed in the terminal instead).
EMAIL_ADDRESS=

# Gmail App Password (NOT your normal Gmail password).
# Go to Google Account -> Security -> 2-Step Verification -> App Passwords.
# Leave empty to use TEST MODE.
EMAIL_PASSWORD=
