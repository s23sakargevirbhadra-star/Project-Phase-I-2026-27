# .env.example
# Copy this file, rename it to .env, and fill in your real values.
# NEVER share your real .env file — keep it private.
# This file contains only FAKE values — it is safe to share.

# MongoDB connection string (local)
MONGO_URI=mongodb://localhost:27017

# Flask session secret key — change to any long random string
SECRET_KEY=change-this-to-a-long-random-string

# Gmail address used to send OTP verification emails
# Leave empty to use TEST MODE (OTP printed in terminal, no email sent)
EMAIL_ADDRESS=your_gmail@gmail.com

# Gmail App Password (NOT your normal password)
# Create one at: Google Account -> Security -> App Passwords
EMAIL_PASSWORD=your_app_password_here
